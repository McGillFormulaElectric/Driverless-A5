# Copy this file to .env and fill in the values.
# .env is gitignored — never commit your auth key.

# Your GitHub username — becomes your ROS namespace AND your Tailscale hostname.
GITHUB_USER=your-github-handle

# MFE Tailscale auth key. Neil generates this each semester from:
#   tailscale.com/admin → Settings → Keys → Generate auth key
# Use a reusable, ephemeral key so it auto-expires and can't be replayed.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxx

# Tailscale hostname of Neil's grading machine (shared in class).
# e.g. neil.tail1234.ts.net or the bare Tailscale IP (100.x.x.x)
A5_NEIL_HOST=neil.your-tailnet.ts.net
